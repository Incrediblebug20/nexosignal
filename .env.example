# Alpaca API credentials
# Get yours free at https://alpaca.markets
# Use PAPER keys for safe testing — no real money at risk

ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Set to "paper" for safe simulation, "live" for real trading
TRADING_MODE=paper
LIVE_TRADING=false
AUTONOMOUS_TRADING=false
REQUIRE_MANUAL_APPROVAL=true
ALPACA_PAPER=true

# === SAFETY LIMITS (edit these to your comfort) ===

# Maximum % of portfolio to put in a single position (0.10 = 10%)
MAX_POSITION_SIZE_PCT=0.10

# Stop all trading for the day if portfolio drops by this % (0.05 = 5%)
DAILY_LOSS_LIMIT_PCT=0.05

# Maximum number of trades allowed per day
MAX_TRADES_PER_DAY=20

# Maximum dollar value per single order
MAX_ORDER_VALUE_USD=1000

# Comma-separated list of allowed symbols (leave blank to allow all, including crypto).
# If set, ONLY these symbols can be traded — add BTC/USD, ETH/USD etc. if you trade crypto.
SYMBOL_WHITELIST=

# Comma-separated list of blocked symbols
SYMBOL_BLACKLIST=

# Minimum cash cushion to always keep in account (USD)
MIN_CASH_RESERVE_USD=500
POSITION_SIZE_PCT=0.10
MAX_DAILY_LOSS_LIMIT=500
MAX_POSITION_SIZE=5000
MIN_RISK_REWARD_RATIO=5.0
MAX_DATA_STALENESS_SECONDS=900
MAX_GUARD_STRIKES=2

# === DASHBOARD ===
# Local dashboard login. Change these before running.
DASHBOARD_BRAND_NAME=NexoSignal
FLASK_SECRET_KEY=change-this-secret-key

# Single-user login (legacy, still works)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Multi-user login — overrides the single-user vars above when set.
# JSON object: { "username1": "password1", "username2": "password2", ... }
# Passwords can be plain text or werkzeug hashes (pbkdf2:... / scrypt:...)
# Example: DASHBOARD_USERS={"admin":"secret123","trader":"mypass456","viewer":"viewonly789"}
DASHBOARD_USERS=

# Supabase/Postgres storage for all manual and automated trade attempts.
# Required locally and on Vercel.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Default bot symbols shown in the dashboard start form
DEFAULT_DASHBOARD_SYMBOLS=AAPL,MSFT,SPY,QQQ,BTC/USD,ETH/USD

# MetaMask public wallet capture in the dashboard
METAMASK_REQUIRED=false

# Signal intelligence approval threshold
SIGNAL_MIN_CONFIDENCE=70

# === MULTI-AGENT AI RESEARCH LAYER ===
# Enables the Gemini + Grok + Claude research panel in the dashboard.
# Set AI_RESEARCH_ENABLED=true and fill in at least one key to activate.

# Google Gemini — market research for stocks, crypto, ETFs, Bitcoin
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Grok (xAI) — real-time news intelligence and short-term prediction charts
# Get key: https://console.x.ai
GROK_API_KEY=

# Claude (Anthropic) — final trade execution with 5:1 risk-reward enforcement
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Enable the AI research layer (requires at least one API key above)
AI_RESEARCH_ENABLED=false

# Minimum risk-to-reward ratio Claude must confirm before approving a trade
# Default is 5.0 (5:1 ratio — risk $1 to gain $5)
AI_MIN_RISK_REWARD_RATIO=5.0
MASTER_CONSENSUS_MIN_CONFIDENCE=70
# Local LLM Master Orchestrator (Ollama — runs on your machine, no API key needed)
# When enabled, this local LLM acts as the MASTER that receives outputs from
# Gemini, Grok, and Claude (the slaves) and issues the final trade verdict.
# Install Ollama: https://ollama.com  |  then run: ollama pull mistral
LOCAL_LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# === NEXOSIGNAL ALERTS ===
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# === NEXOSIGNAL PHASE 2 — INTELLIGENCE EXTENSION ===

# Financial Modeling Prep — fundamentals, screener (free: 250 calls/day)
# Get key: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# NewsAPI.org — headline news for sentiment (free: 100 requests/day)
# Get key: https://newsapi.org/register
NEWS_API_KEY=

# FRED (St. Louis Fed) — macro data: yields, jobless claims (free, no rate limit)
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Market data fallback order. Supported values: alpaca, yahoo, tradingview.
MARKET_DATA_PROVIDER=alpaca,yahoo,tradingview

# Optional secret required by /webhooks/tradingview when set.
TRADINGVIEW_WEBHOOK_SECRET=

# NexoSignal Guard — portfolio VaR hard limit (0.02 = 2 % of portfolio value)
MAX_PORTFOLIO_VAR=0.02

# NexoSignal Scout — number of symbols to maintain in the watchlist
WATCHLIST_SIZE=30

# NexoSignal Lens — local FinBERT model path or HuggingFace model ID
# Requires: pip install transformers torch  (optional, ~500 MB download)
FINBERT_MODEL_PATH=ProsusAI/finbert

# === CHART PAGE ===
# Default symbols loaded on the portfolio dashboard on first visit.
# The chart page always starts from /chart/<symbol> and the user can
# type any symbol in the search box.
# Allowed chart timeframes: 1Min,5Min,15Min,30Min,1Hour,4Hour,1Day,1Week,1Month
# OHLCV cache TTL is set automatically by timeframe (30 s for intraday, up to 300 s for daily).

# ⚠ PAPER TRADING SAFETY NOTICE ⚠
# Keep TRADING_MODE=paper and ALPACA_PAPER=true until you have validated
# the bot's dry-run results across multiple live market sessions.
# NexoSignal does not guarantee profitable trades.
# Never risk capital you cannot afford to lose.
